---
import Layout from '../layouts/Layout.astro';
import { getArticles } from '../lib/sanity';

const articles = await getArticles();
---

<Layout>
	<main>
		<p class="kicker">Temple Magazine</p>
		<h1>Astro + Sanity</h1>
		<p class="lede">
			WordPress content will land here. Add an article in Studio, then refresh this page.
		</p>
		{articles.length === 0 ? (
			<p class="empty">No articles yet. Run <code>npm run dev:studio</code> and publish one.</p>
		) : (
			<ul>
				{articles.map((article) => (
					<li>
						<strong>{article.title}</strong>
						{article.excerpt && <p>{article.excerpt}</p>}
					</li>
				))}
			</ul>
		)}
	</main>
</Layout>

<style>
	main {
		max-width: 40rem;
		margin: 4rem auto;
		padding: 0 1.5rem;
		font-family: Georgia, 'Times New Roman', serif;
	}

	.kicker {
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-size: 0.75rem;
		font-family: system-ui, sans-serif;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 400;
		margin: 0.25rem 0 1rem;
	}

	.lede,
	.empty {
		line-height: 1.5;
		color: #333;
	}

	.empty code {
		font-size: 0.9em;
	}

	ul {
		padding: 0;
		list-style: none;
	}

	li + li {
		margin-top: 1.25rem;
	}
</style>
